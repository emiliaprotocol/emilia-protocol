{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.emiliaprotocol.ai/schemas/ep-claim-case.schema.json",
  "title": "EP-CLAIM-CASE-v1",
  "description": "A strict, replayable set of typed evidence artifacts bound to one subject, scope, claim, pinned profile, and optional exact action. A Claim Case presents evidence, not trust or authority.",
  "type": "object",
  "required": [
    "@type",
    "subject_digest",
    "scope_digest",
    "claim",
    "profile_id",
    "profile_hash",
    "as_of",
    "evidence"
  ],
  "additionalProperties": false,
  "properties": {
    "@type": { "const": "EP-CLAIM-CASE-v1" },
    "subject_digest": { "$ref": "#/$defs/digest" },
    "scope_digest": { "$ref": "#/$defs/digest" },
    "claim": { "$ref": "#/$defs/claim" },
    "profile_id": { "$ref": "#/$defs/identifier" },
    "profile_hash": { "$ref": "#/$defs/digest" },
    "action_digest": { "$ref": "#/$defs/digest" },
    "as_of": { "$ref": "#/$defs/instant" },
    "evidence": {
      "type": "array",
      "maxItems": 32,
      "items": { "$ref": "#/$defs/evidence" }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "instant": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "verifier": {
      "type": "object",
      "required": ["verifier_id", "verifier_version", "implementation_digest"],
      "additionalProperties": false,
      "properties": {
        "verifier_id": { "$ref": "#/$defs/identifier" },
        "verifier_version": { "$ref": "#/$defs/identifier" },
        "implementation_digest": { "$ref": "#/$defs/digest" }
      }
    },
    "claim": {
      "type": "object",
      "required": ["claim_id", "claim_type", "predicate", "value"],
      "additionalProperties": false,
      "properties": {
        "claim_id": { "$ref": "#/$defs/identifier" },
        "claim_type": { "$ref": "#/$defs/label" },
        "predicate": { "$ref": "#/$defs/label" },
        "value": {}
      }
    },
    "binding": {
      "type": "object",
      "required": ["subject_digest", "scope_digest", "claim_id"],
      "additionalProperties": false,
      "properties": {
        "subject_digest": { "$ref": "#/$defs/digest" },
        "scope_digest": { "$ref": "#/$defs/digest" },
        "claim_id": { "$ref": "#/$defs/identifier" },
        "action_digest": { "$ref": "#/$defs/digest" }
      }
    },
    "evidence": {
      "type": "object",
      "required": [
        "evidence_id",
        "role",
        "verifier",
        "binding",
        "artifact",
        "artifact_digest"
      ],
      "additionalProperties": false,
      "properties": {
        "evidence_id": { "$ref": "#/$defs/identifier" },
        "role": { "$ref": "#/$defs/identifier" },
        "verifier": { "$ref": "#/$defs/verifier" },
        "binding": { "$ref": "#/$defs/binding" },
        "artifact": {},
        "artifact_digest": { "$ref": "#/$defs/digest" }
      }
    }
  }
}
