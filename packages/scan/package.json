{
  "name": "@emilia-protocol/scan",
  "version": "0.3.8",
  "description": "Passive local authority inventory plus fail-closed static classification for MCP and OpenAPI action surfaces.",
  "license": "Apache-2.0",
  "homepage": "https://www.emiliaprotocol.ai/scan",
  "bugs": {
    "url": "https://github.com/emiliaprotocol/emilia-protocol/issues"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "type": "module",
  "main": "index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./index.js",
      "types": "./dist/index.d.ts"
    },
    "./authority": {
      "import": "./dist/authority/index.js",
      "types": "./dist/authority/index.d.ts"
    }
  },
  "bin": {
    "scan": "cli.mjs",
    "emilia-scan": "cli.mjs",
    "emilia-harden": "codemod.mjs"
  },
  "files": [
    "index.js",
    "dist",
    "src",
    "risk-packs.js",
    "risk-packs.d.ts",
    "cli.mjs",
    "codemod.mjs",
    "safe-file.mjs",
    "CHANGELOG.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "pretest": "npm run build",
    "test": "node --test test.js authority.test.mjs classification.test.mjs packed-consumer.test.mjs"
  },
  "dependencies": {
    "@emilia-protocol/verify": "^3.10.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/emiliaprotocol/emilia-protocol.git",
    "directory": "packages/scan"
  },
  "keywords": [
    "emilia",
    "ai-agent",
    "authorization",
    "mcp",
    "openapi",
    "guardrails"
  ]
}
