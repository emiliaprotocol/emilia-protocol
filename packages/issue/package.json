{
  "name": "@emilia-protocol/issue",
  "version": "0.7.0",
  "description": "Zero-dependency local issuance of EP authorization receipts (EP-AUTHORIZATION-RECEIPT-v1; I-D draft-schrock-ep-authorization-receipts \u00a76.2), signed locally with your own keys. The signing-side companion to @emilia-protocol/verify: issue locally, verify anywhere. Issuance uses Node built-in crypto only; the `demo` command self-verifies via an optional @emilia-protocol/verify. No EP infrastructure required.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "import": "./index.js",
      "types": "./dist/index.d.ts"
    },
    "./hybrid-issuance": {
      "types": "./dist/hybrid-issuance.d.ts",
      "import": "./hybrid-issuance.js"
    }
  },
  "bin": {
    "ep-issue": "./cli.js",
    "emilia-issue": "./cli.js"
  },
  "files": [
    "index.js",
    "dist/",
    "src/",
    "tsconfig.json",
    "cli.js",
    "strict-json.js",
    "strict-json.js.map",
    "strict-json.d.ts",
    "index.d.ts",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "hybrid-issuance.js"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "emilia-protocol",
    "authorization-receipts",
    "receipts",
    "ai-agent",
    "ed25519",
    "merkle",
    "offline-verification",
    "zero-dependency"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/emiliaprotocol/emilia-protocol.git",
    "directory": "packages/issue"
  },
  "homepage": "https://www.emiliaprotocol.ai/adopt",
  "bugs": {
    "url": "https://github.com/emiliaprotocol/emilia-protocol/issues"
  },
  "author": "EMILIA Protocol, Inc.",
  "publishConfig": {
    "access": "public"
  },
  "optionalDependencies": {
    "@emilia-protocol/verify": "^3.21.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "pretest": "npm run build",
    "test": "node --test test.js log-checkpoint-hybrid.test.mjs"
  }
}
