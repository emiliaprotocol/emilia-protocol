{
  "name": "@emilia-protocol/consequence-actuator-service",
  "version": "0.1.0",
  "private": true,
  "description": "Credential-owning, one-time consequence actuator service.",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "exports": {
    ".": "./dist/runtime.js",
    "./github-deployment-server": "./dist/github-deployment-server.js",
    "./github-deployment-webhook": "./dist/github-deployment-webhook.js",
    "./observation": "./dist/observation.js",
    "./production-config": "./dist/production-config.js",
    "./routes": "./dist/routes.js",
    "./server": "./dist/server.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@emilia-protocol/gate": "file:../../packages/gate",
    "@emilia-protocol/require-receipt": "file:../../packages/require-receipt",
    "@emilia-protocol/verify": "file:../../packages/verify",
    "@noble/curves": "2.2.0",
    "pg": "8.22.0"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/pg": "^8.15.6",
    "tsx": "^4.19.3",
    "typescript": "^5.9.3"
  },
  "license": "Apache-2.0"
}
