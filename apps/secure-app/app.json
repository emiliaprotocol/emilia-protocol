{
  "expo": {
    "name": "EMILIA Secure",
    "slug": "emilia-secure-app",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "scheme": "emiliasecure",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "ai.emiliaprotocol.secure",
      "infoPlist": {
        "NSFaceIDUsageDescription": "EMILIA Secure uses Face ID to unlock its local software-key diagnostic. Live action approval is unavailable in this build."
      }
    },
    "android": {
      "package": "ai.emiliaprotocol.secure"
    },
    "plugins": [
      "expo-secure-store",
      "expo-local-authentication",
      "expo-asset",
      "expo-status-bar"
    ]
  }
}
