{
  "name": "@emilia-protocol/secure-app",
  "version": "0.1.0",
  "private": true,
  "description": "EMILIA mobile approval shell with runtime pairing and an explicitly non-Class-A software-key diagnostic.",
  "license": "Apache-2.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "test": "node --test lib/*.test.mjs",
    "check:expo-quarantine": "node scripts/check-expo-quarantine.mjs",
    "audit:dependencies": "node ../../scripts/audit-with-exceptions.mjs --prefix . --audit-level=low"
  },
  "expo": {
    "install": {
      "exclude": [
        "expo",
        "expo-asset",
        "expo-secure-store"
      ]
    }
  },
  "dependencies": {
    "@noble/curves": "2.3.0",
    "@noble/hashes": "2.3.0",
    "expo": "~57.0.15",
    "expo-asset": "~57.0.15",
    "expo-local-authentication": "~57.0.2",
    "expo-screen-capture": "~57.0.2",
    "expo-secure-store": "~57.0.2",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.3"
  },
  "overrides": {
    "@expo/metro": "56.0.2",
    "brace-expansion": "5.0.9",
    "metro": "0.84.5",
    "nanoid": "3.3.18",
    "postcss": "8.5.25",
    "uuid": "11.1.1"
  },
  "devDependencies": {
    "babel-preset-expo": "~57.0.0",
    "expo-doctor": "1.20.2"
  }
}
