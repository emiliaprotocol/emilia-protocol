        { "action_field": "amount", "source_path": "/message/metadata/https:~1~1emiliaprotocol.ai~1extensions~1a2a~1receipt-binding~1v1/action/amount" },
        { "action_field": "currency", "source_path": "/message/metadata/https:~1~1emiliaprotocol.ai~1extensions~1a2a~1receipt-binding~1v1/action/currency" },
        {
          "action_field": "beneficiary_account",
