# syntax=docker/dockerfile:1.7

# This builds a local BYOC artifact. It is not an official published image.
# Override NODE_IMAGE with an organization-approved digest when required.
ARG NODE_IMAGE=node:22.23.1-alpine3.24@sha256:16e22a550f3863206a3f701448c45f7912c6896a62de43add43bb9c86130c3e2

FROM ${NODE_IMAGE} AS dependencies
WORKDIR /opt/gate

ARG EMILIA_VERIFY_PACKAGE_SHA256
ARG EMILIA_GATE_PACKAGE_SHA256
ARG EMILIA_REQUIRE_RECEIPT_PACKAGE_SHA256

# apps/gate-service is dependency-light. pg backs the built-in environment
# factory's durable Postgres stores. Cloud KMS SDKs remain operator choices in
# a derived image that uses an explicit operator config.
COPY release-packages /opt/release-packages
RUN printf '%s  %s\n' \
      "$EMILIA_VERIFY_PACKAGE_SHA256" /opt/release-packages/verify.tgz \
      "$EMILIA_GATE_PACKAGE_SHA256" /opt/release-packages/gate.tgz \
      "$EMILIA_REQUIRE_RECEIPT_PACKAGE_SHA256" /opt/release-packages/require-receipt.tgz \
      | sha256sum -c - \
    && mkdir -p packages/verify packages/gate packages/require-receipt \
    && tar -xzf /opt/release-packages/verify.tgz -C packages/verify --strip-components=1 \
    && tar -xzf /opt/release-packages/gate.tgz -C packages/gate --strip-components=1 \
    && tar -xzf /opt/release-packages/require-receipt.tgz -C packages/require-receipt --strip-components=1

COPY apps/gate-service/package.json apps/gate-service/package-lock.json apps/gate-service/
RUN npm ci --prefix apps/gate-service --omit=dev --ignore-scripts --no-audit --no-fund \
    && npm install --prefix apps/gate-service --omit=dev --ignore-scripts --no-audit --no-fund \
      --no-save --package-lock=false \
      /opt/release-packages/verify.tgz \
      /opt/release-packages/require-receipt.tgz \
      /opt/release-packages/gate.tgz \
    && npm cache clean --force

FROM ${NODE_IMAGE} AS runtime

ARG EMILIA_SOURCE_REVISION=local-unverified
ARG EMILIA_SOURCE_TREE=local-unverified
ARG EMILIA_SOURCE_MANIFEST_SHA256=local-unverified
ARG EMILIA_VERIFY_PACKAGE_SHA256=local-unverified
ARG EMILIA_GATE_PACKAGE_SHA256=local-unverified
ARG EMILIA_REQUIRE_RECEIPT_PACKAGE_SHA256=local-unverified
ARG EMILIA_SECURITY_CASE_SHA256=local-unverified
ARG EMILIA_PROOF_STATS_SHA256=local-unverified
ARG EMILIA_CONFORMANCE_MANIFEST_SHA256=local-unverified

LABEL org.opencontainers.image.title="EMILIA Gate BYOC reference image" \
      org.opencontainers.image.description="Operator-built HTTP enforcement service for EMILIA Gate" \
      org.opencontainers.image.source="https://github.com/emiliaprotocol/emilia-protocol" \
      org.opencontainers.image.licenses="Apache-2.0" \
      org.opencontainers.image.revision="${EMILIA_SOURCE_REVISION}" \
      io.emilia.image.component="gate" \
      io.emilia.source.tree="${EMILIA_SOURCE_TREE}" \
      io.emilia.source.manifest.sha256="${EMILIA_SOURCE_MANIFEST_SHA256}" \
      io.emilia.package.verify.sha256="${EMILIA_VERIFY_PACKAGE_SHA256}" \
      io.emilia.package.gate.sha256="${EMILIA_GATE_PACKAGE_SHA256}" \
      io.emilia.package.require-receipt.sha256="${EMILIA_REQUIRE_RECEIPT_PACKAGE_SHA256}" \
      io.emilia.governed.security-case.sha256="${EMILIA_SECURITY_CASE_SHA256}" \
      io.emilia.governed.proof-stats.sha256="${EMILIA_PROOF_STATS_SHA256}" \
      io.emilia.governed.conformance.sha256="${EMILIA_CONFORMANCE_MANIFEST_SHA256}"

RUN addgroup -S -g 10001 gate \
    && adduser -S -D -H -u 10001 -G gate gate \
    && mkdir -p /app/config /tmp \
    && chown -R 10001:10001 /app /tmp \
    && rm -rf /usr/local/lib/node_modules/npm \
              /usr/local/lib/node_modules/corepack \
              /opt/yarn-v1.22.22 \
    && rm -f /usr/local/bin/npm \
             /usr/local/bin/npx \
             /usr/local/bin/corepack \
             /usr/local/bin/yarn \
             /usr/local/bin/yarnpkg

WORKDIR /app

COPY --from=dependencies --chown=10001:10001 /opt/gate/apps/gate-service/node_modules ./node_modules
COPY --chown=10001:10001 apps/gate-service/package.json ./apps/gate-service/package.json
COPY --chown=10001:10001 apps/gate-service/openapi.json ./apps/gate-service/openapi.json
COPY --chown=10001:10001 apps/gate-service/src ./apps/gate-service/src
COPY --from=dependencies --chown=10001:10001 /opt/gate/packages ./packages

# Relative service imports use the package trees extracted from checksum-verified
# tarballs, while package-specifier imports use npm's installs of those same
# sealed tarballs. No checkout package source can replace either runtime path.
RUN find /app/packages -type f \( -name '*.test.js' -o -name '*.test.mjs' \) -delete \
    && rm -rf /app/packages/gate/deploy/helm /app/packages/gate/deploy/terraform

ENV NODE_ENV=production \
    HOST=0.0.0.0 \
    PORT=8080

USER 10001:10001
EXPOSE 8080
STOPSIGNAL SIGTERM

HEALTHCHECK --interval=10s --timeout=3s --start-period=10s --retries=3 \
  CMD ["node", "-e", "fetch('http://127.0.0.1:' + process.env.PORT + '/v1/live').then((r) => process.exit(r.ok ? 0 : 1)).catch(() => process.exit(1))"]

ENTRYPOINT ["node", "apps/gate-service/src/server.js"]
