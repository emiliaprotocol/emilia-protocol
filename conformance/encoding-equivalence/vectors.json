{
  "suite": "EP-COSE-ENCODING-v0.1",
  "description": "Encoding-equivalence vectors: one EP receipt, its RFC 8785 canonical JSON bytes, its deterministic CBOR mapping (RFC 8949 Section 4.2.1), and a COSE_Sign1 (tag 18) transport/registration envelope. The vectors prove the jcs-sha256 CAID is byte-identical regardless of envelope encoding and that the CBOR mapping round-trips to identical canonical JSON bytes. The COSE envelope signature is a transport attestation by the envelope key holder; it is not the approval signature and confers no trust semantics.",
  "deterministic_encoding": {
    "rule": "RFC 8949 Section 4.2.1",
    "map_key_order": "bytewise lexicographic order of the deterministic encodings of the keys; NOT the RFC 7049 Section 3.9 length-first ordering",
    "forbidden": [
      "non-shortest-form arguments",
      "indefinite-length items",
      "unsorted or duplicate map keys",
      "floats and non-integer numbers",
      "tags inside the payload domain"
    ]
  },
  "keys": {
    "note": "TEST KEYS ONLY, derived from public seed strings; never use for anything.",
    "issuer": {
      "derivation": "seed = SHA-256('EP-COSE-ENCODING-v0.1/issuer-test-key')",
      "seed_hex": "63dbb671da18d0f4dded5b9a7c6098dab3fadc237ea299a5d81aa979d0a5327d",
      "public_key_spki_b64u": "MCowBQYDK2VwAyEAwZcuH8rGW-fdnGxrB7a4uMJOQ2dQDJnq78KCahSOTWw"
    },
    "envelope": {
      "derivation": "seed = SHA-256('EP-COSE-ENCODING-v0.1/envelope-test-key')",
      "seed_hex": "ac4f7f01225eb6db46c7b74b399bfcfed0706d1b8ca71a59e2761e32aa278db4",
      "public_key_spki_b64u": "MCowBQYDK2VwAyEAWhxYc5n_WaM130boDZc-UV7Dl6_ELD-eqt8cvxPmuQc"
    }
  },
  "receipt": {
    "@version": "EP-RECEIPT-v1",
    "payload": {
      "receipt_id": "tr_cose_encoding_v0_1",
      "issuer": "ep_demo_treasury_v1",
      "issued_at": "2026-08-16T00:00:00Z",
      "action": {
        "action_type": "payment.release.1",
        "amount": "40000.00",
        "currency": "USD",
        "beneficiary_account": "sha256:12f641b8c481e23c00148de1bb73989601dfa6a5562f72b5e358fcda6e8eb674",
        "payment_instruction_id": "pi_42"
      },
      "quorum_threshold": 10,
      "context": {
        "organization": "demo_treasury"
      }
    },
    "signature": {
      "algorithm": "Ed25519",
      "value": "6y1bwgQs8IBXa7i1p93PONMorujPJaWM0buTMdz4hyRm4d-e4cC3_BlUiT2hleIJUPBJcD1H259Ym2rXH1u8Dg"
    }
  },
  "expected": {
    "receipt_canonical_json": "{\"@version\":\"EP-RECEIPT-v1\",\"payload\":{\"action\":{\"action_type\":\"payment.release.1\",\"amount\":\"40000.00\",\"beneficiary_account\":\"sha256:12f641b8c481e23c00148de1bb73989601dfa6a5562f72b5e358fcda6e8eb674\",\"currency\":\"USD\",\"payment_instruction_id\":\"pi_42\"},\"context\":{\"organization\":\"demo_treasury\"},\"issued_at\":\"2026-08-16T00:00:00Z\",\"issuer\":\"ep_demo_treasury_v1\",\"quorum_threshold\":10,\"receipt_id\":\"tr_cose_encoding_v0_1\"},\"signature\":{\"algorithm\":\"Ed25519\",\"value\":\"6y1bwgQs8IBXa7i1p93PONMorujPJaWM0buTMdz4hyRm4d-e4cC3_BlUiT2hleIJUPBJcD1H259Ym2rXH1u8Dg\"}}",
    "receipt_canonical_sha256_hex": "bca6b816579c5eb35209a658a295574181d0769023b336b3a938efc086a468e2",
    "caid": "caid:1:payment.release.1:jcs-sha256:QTaLIbejZIti7ZbTxOwv-iAu6jbwNCkNSUyuac3jpiA",
    "caid_action_digest": "sha256:41368b21b7a3648b62ed96d3c4ec2ffa202eea36f034290d494cae69cde3a620",
    "receipt_cbor_hex": "",
    "cose_sign1_hex": "",
    "cose_payload_sha256_hex": "bca6b816579c5eb35209a658a295574181d0769023b336b3a938efc086a468e2",
    "cose_protected_header_hex": "",
    "cose_kid": "ep-cose-encoding-test-envelope-key"
  },
  "vectors": [
    {
      "id": "payload-digest-equality",
      "kind": "equivalence",
      "statement": "SHA-256 of the receipt canonical JSON bytes equals SHA-256 of the COSE_Sign1 payload bytes: the envelope carries exactly the bytes the receipt signature covers.",
      "expect": {
        "equal": [
          "expected.receipt_canonical_sha256_hex",
          "expected.cose_payload_sha256_hex"
        ]
      }
    },
    {
      "id": "caid-encoding-invariance",
      "kind": "equivalence",
      "statement": "The jcs-sha256 CAID recomputed from the action object after decoding expected.receipt_cbor_hex is byte-identical to the CAID computed from the JSON form and to the ep.caid protected header.",
      "expect": {
        "caid": "caid:1:payment.release.1:jcs-sha256:QTaLIbejZIti7ZbTxOwv-iAu6jbwNCkNSUyuac3jpiA"
      }
    },
    {
      "id": "round-trip-stability",
      "kind": "equivalence",
      "statement": "decode(expected.receipt_cbor_hex) re-canonicalizes to expected.receipt_canonical_json, and re-encoding yields expected.receipt_cbor_hex byte-for-byte.",
      "expect": {
        "stable": true
      }
    },
    {
      "id": "cose-verify-accept",
      "kind": "accept",
      "statement": "expected.cose_sign1_hex verifies under the two pinned test keys; every check true. VERIFIED here means the cryptographic checks pass under the supplied pins; it is never ACCEPTED (a relying-party trust decision).",
      "expect": {
        "valid": true,
        "checks": {
          "deterministic_encoding": true,
          "cose_structure": true,
          "envelope_signature": true,
          "payload_canonical": true,
          "receipt_signature": true,
          "caid_consistent": true
        }
      }
    },
    {
      "id": "hostile-unsorted-map-keys",
      "kind": "refusal",
      "statement": "The same receipt content with the top-level map entries out of deterministic order: '@version' placed before 'payload'. Under RFC 8949 bytewise order of the encoded keys, 'payload' (header 0x67) sorts before '@version' (header 0x68), even though JCS puts '@version' first. A lenient decoder would accept the swapped form and observe equal semantics; this profile refuses it.",
      "input_cbor_hex": "",
      "expect": {
        "ok": false,
        "reason": "non_deterministic_encoding"
      }
    },
    {
      "id": "hostile-non-shortest-int",
      "kind": "refusal",
      "statement": "The same receipt content with the integer 10 encoded in two-byte form (0x180a) instead of shortest form (0x0a).",
      "input_cbor_hex": "",
      "expect": {
        "ok": false,
        "reason": "non_deterministic_encoding"
      }
    },
    {
      "id": "hostile-indefinite-length-map",
      "kind": "refusal",
      "statement": "The same receipt content wrapped in an indefinite-length map (0xbf ... 0xff).",
      "input_cbor_hex": "",
      "expect": {
        "ok": false,
        "reason": "non_deterministic_encoding"
      }
    },
    {
      "id": "hostile-tampered-payload-intact-headers",
      "kind": "refusal",
      "statement": "A COSE_Sign1 whose payload amount was changed 40000.00 -> 40000.01 while protected headers and signature bytes stay intact. The envelope signature no longer covers the payload; verification refuses before ever reading the receipt.",
      "input_cose_hex": "",
      "expect": {
        "valid": false,
        "reason": "envelope_signature_invalid",
        "checks_envelope_signature": false
      }
    }
  ]
}
