{
  "@version": "AEB-PSEA-CONFORMANCE-v1",
  "source_revision": "draft-yossif-psea-02",
  "profile": "urn:ietf:params:psea:eat-profile:1",
  "notes": [
    "PSEA is verified as optional human-authorization evidence; EMILIA Gate remains the final effect admission authority.",
    "The executable test mints each deterministic ES256/JCS fixture from the mutation descriptor below.",
    "No vector claims independent PSEA interoperability or IETF consensus."
  ],
  "vectors": [
    { "id": "accept_valid_proof", "mutation": "none", "accepted": true, "reason": null },
    { "id": "reject_jti_replay", "mutation": "replay_same_proof", "accepted": false, "reason": "psea:jti_replay" },
    { "id": "reject_counter_rollback", "mutation": "new_jti_same_counter", "accepted": false, "reason": "psea:counter_rollback" },
    { "id": "reject_wrong_audience", "mutation": "audience", "accepted": false, "reason": "psea:audience_mismatch" },
    { "id": "reject_stale_proof", "mutation": "expired", "accepted": false, "reason": "psea:proof_expired" },
    { "id": "reject_noncanonical_payload", "mutation": "payload_member_order", "accepted": false, "reason": "psea:malformed_or_noncanonical_jws" },
    { "id": "reject_wrong_operation", "mutation": "operation", "accepted": false, "reason": "psea:operation_mismatch" },
    { "id": "reject_inadequate_attestation", "mutation": "attestation", "accepted": false, "reason": "psea:inadequate_attestation" },
    { "id": "reject_action_canonicalization_difference", "mutation": "action_payload", "accepted": false, "reason": "psea:action_hash_mismatch" }
  ]
}
