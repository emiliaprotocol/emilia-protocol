{
  "name": "@emilia-protocol/mcp-server",
  "mcpName": "io.github.emiliaprotocol/mcp-server",
  "version": "2.1.4",
  "description": "A focused MCP front door for consequential agent actions: request exact-action approval, poll signoff, and verify the resulting receipt.",
  "main": "bundle.js",
  "type": "module",
  "bin": {
    "emilia-mcp": "./bundle.js"
  },
  "files": [
    "bundle.js",
    "auto-receipt.js",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build-bundle.mjs",
    "prepack": "npm run build",
    "test": "vitest run"
  },
  "dependencies": {
    "@emilia-protocol/verify": "^8.0.0"
  },
  "overrides": {
    "@hono/node-server": "2.1.7",
    "body-parser": "2.4.0",
    "fast-uri": "3.1.9",
    "hono": "4.13.13",
    "qs": "6.17.0",
    "ip-address": "10.7.4"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "esbuild": "^0.28.1",
    "vitest": "^5.0.1"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "human-in-the-loop",
    "human-signoff",
    "webauthn",
    "passkey",
    "irreversible-actions",
    "payment-guard",
    "agent-accountability",
    "agent-safety",
    "ai-agents",
    "trust-receipt",
    "offline-verification",
    "separation-of-duties",
    "policy-evaluation",
    "delegation",
    "emilia-protocol"
  ],
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/emiliaprotocol/emilia-protocol.git"
  },
  "homepage": "https://emiliaprotocol.ai",
  "bugs": {
    "url": "https://github.com/emiliaprotocol/emilia-protocol/issues"
  }
}
