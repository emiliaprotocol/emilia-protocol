{
  "@version": "EP-ACTION-RISK-MANIFEST-v0.1",
  "service": { "name": "your-service", "manifest_url": "/.well-known/agent-actions.json" },
  "actions": [
    {
      "id": "mcp.delete_all_records",
      "description": "Irreversible: deletes every record in the table. Requires a named human's authorization receipt.",
      "match": { "protocol": "mcp", "tool": "delete_all_records" },
      "action_type": "db.records.delete_all",
      "risk": "critical",
      "receipt_required": true,
      "assurance_class": "class_a",
      "max_age_sec": 900,
      "execution_binding": { "required_fields": ["table"] },
      "quorum": { "required": false }
    },
    {
      "id": "mcp.list_tables",
      "description": "Read-only: lists table names. Reversible, so no receipt is demanded — and this entry is what makes that an author's decision on record rather than an absence the dispatcher has to guess about.",
      "match": { "protocol": "mcp", "tool": "list_tables" },
      "action_type": "db.tables.list",
      "risk": "low",
      "receipt_required": false
    }
  ]
}
