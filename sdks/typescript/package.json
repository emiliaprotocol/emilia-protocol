{
  "name": "@emilia-protocol/sdk",
  "version": "0.11.0",
  "description": "TypeScript SDK for EMILIA exact-action authority, receipt acquisition, one-time consumption, execution evidence, and offline-verifiable evidence export.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist",
    "prepare": "npm run clean && npm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "trust",
    "ai-agents",
    "emilia-protocol",
    "handshake",
    "trust-gate",
    "signoff"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/emiliaprotocol/emilia-protocol.git",
    "directory": "sdks/typescript"
  },
  "homepage": "https://emiliaprotocol.ai",
  "devDependencies": {
    "@types/node": "^26.3.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  }
}
